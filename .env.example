TELEGRAM_BOT_TOKEN=123456789:replace_with_token_from_BotFather
SITE_URL=https://www.routesandroads.fr
# Необязательно: разрешить запуск проверки только указанным Telegram chat ID.
# ALLOWED_CHAT_IDS=123456789,987654321

# Обязательно для ежедневной отправки: ID группового чата или @username канала.
# Узнать ID группы/темы: добавьте бота в нужное место и отправьте /where.
TARGET_CHAT_ID=-1001234567890
# Только для группы с темами (форумом). Для обычного чата оставьте строку закомментированной.
# TARGET_MESSAGE_THREAD_ID=123

# Ежедневная проверка. По умолчанию: 09:00 по Москве.
SCHEDULE_TIME=09:00
SCHEDULE_TIMEZONE=Europe/Moscow
